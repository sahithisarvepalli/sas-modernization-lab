# Example local overrides for SAS modernization lab
PYTHONPATH=/workspaces/sas-modernization-lab

# SASPy connection profile name (must match a key in sascfg_personal.py)
SASPY_CFG=/workspaces/sas-modernization-lab/config/sascfg_personal.py
SASPY_CFGNAME=default

# SAS Workspace Server (IOM access mode — used by SASPy for traditional SAS)
SAS_SERVER=sas-server.example.com
SAS_PORT=8591
SAS_USER=your_sas_user

# SAS Viya — REST API + python-swat (CAS) connection
VIYA_HOST=https://your-viya-server.example.com
VIYA_CLIENT_ID=your_oauth_client_id
VIYA_CLIENT_SECRET=your_oauth_client_secret
# Token can also be supplied directly for service-account workflows
# VIYA_TOKEN=your_bearer_token

# CAS (Cloud Analytic Services) — python-swat direct connection
CAS_HOST=cas.example.com
CAS_PORT=5570
CAS_USER=your_cas_user
CAS_AUTHINFO=/workspaces/sas-modernization-lab/config/.authinfo
